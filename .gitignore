[Oo]bj/
[Ll]og/
[Tt]emp/
*.obj
*.exe
*.dll
*.pdb
*.cache
*.so
*.dylib
*.lib

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# Visual Studio generated files
.vs
.vs/
.vscode/
*.sln.iml

# Test results
[Tt]est[Rr]esult*/
*.VisualState.xml
*.coverage
*.coveragexml

# NuGet packages
*.nupkg
*.snupkg
# The packages folder can be ignored except for build targets.
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# Build logs
*.tlog
*.log
*.wrn
*.err

# Backup & autosave
*~*
*.bak
*.swp
*.tmp
*.temp
*.old

# IDE config
.idea/
*.DotSettings
*.DotSettings.user

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Rider / JetBrains
.idea/
*.sln.iml

# Publish output
publish/
*.Publish.xml

# ReSharper
_ReSharper*/
*.DotSettings.user

# Entity Framework
*_MigrationHistory/
*.dbmdl

# NCrunch
_NCrunch_*
.*crunch*.local.xml

# Azure
*.azurePubxml
*.pubxml.user

# dotenv / secrets
.env
.env.*

# Cache files
*.cache
*.config.user
*.db

